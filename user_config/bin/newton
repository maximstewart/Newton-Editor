#!/bin/bash

# . CONFIG.sh

# set -o xtrace       ## To debug scripts
# set -o errexit      ## To exit on error
# set -o errunset     ## To exit if a variable is referenced but not set

export PYTHONDONTWRITEBYTECODE=1


function main() {
    call_path=`pwd`

    files=()
    for f in "$@"; do
        target=$(readlink -f "${f}")
        i="${#files[@]}"
        size=$(($i + 1))
        files[$size]="${target}"
    done

    python /opt/newton.zip "${files[@]}"
}
main "$@";
